# Browser requests use the Vite development proxy by default.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:3001
# Routes that have not yet been rebuilt open in the existing application.
VITE_LEGACY_APP_URL=http://localhost:3000

# Public Mapbox token (pk.*) used by the lake detail map.
VITE_MAPBOX_ACCESS_TOKEN=
